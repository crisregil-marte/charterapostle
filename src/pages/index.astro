import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';

export const prerender = true;

const posts = await getCollection('posts');

const homepageEntries = await getCollection('homepageSettings');
const homepage = homepageEntries[0]?.data;
const appearanceEntries = await getCollection('appearanceSettings');
const appearance = appearanceEntries[0]?.data;
const videos = (await getCollection('videos')).sort(
  (a, b) => a.data.displayOrder - b.data.displayOrder
);

// Convert common YouTube link formats into embeddable URLs.
const getYouTubeEmbedUrl = (url) => {
  try {
    const parsed = new URL(url);
    let videoId = '';

    if (parsed.hostname === 'youtu.be') {
      videoId = parsed.pathname.slice(1);
    } else if (parsed.hostname.includes('youtube.com')) {
      if (parsed.pathname === '/watch') {
        videoId = parsed.searchParams.get('v') ?? '';
      } else if (
        parsed.pathname.startsWith('/embed/') ||
        parsed.pathname.startsWith('/shorts/')
      ) {
        videoId = parsed.pathname.split('/')[2] ?? '';
      }
    }

    return /^[a-zA-Z0-9_-]{11}$/.test(videoId)
      ? `https://www.youtube.com/embed/${videoId}`
      : null;
  } catch {
    return null;
  }
};
const featuredPost = posts[0] ?? null;
const archivePosts = posts.slice(1);

const FeaturedContent = featuredPost
  ? (await render(featuredPost)).Content
  : null;
const firstVideo = videos[0] ?? null;

const firstEmbedUrl = firstVideo
  ? getYouTubeEmbedUrl(firstVideo.data.videoUrl)
  : null;

const firstMp4Url = firstVideo?.data.videoFile
  ? firstVideo.data.videoFile.startsWith('http')
    ? firstVideo.data.videoFile
    : `${import.meta.env.BASE_URL}${firstVideo.data.videoFile.replace(/^\/+/, '')}`
  : null;

const firstThumbnail = firstVideo?.data.thumbnail
  ? `${import.meta.env.BASE_URL}${firstVideo.data.thumbnail.replace(/^\/+/, '')}`
  : null;
const base = import.meta.env.BASE_URL;
const contactProcessImage = homepage?.contactProcessImage
  ? `${base}${homepage.contactProcessImage.replace(/^\/+/, '')}`
  : null;
// Makes internal links work locally and on GitHub Pages.
const internalHref = (path, fallback) => {
  const value = (path || fallback).trim();

  if (
    value.startsWith('#') ||
    /^https?:\/\//i.test(value) ||
    /^(mailto:|tel:)/i.test(value)
  ) {
    return value;
  }

  return `${base}${value.replace(/^\/+/, '')}`;
};
---

<Layout title={homepage?.heroTitle ?? 'Process Apostle'}>
 
  <!-- Floating Back to Top Button -->
  <a href="#top" class="back-to-top">↑ Home</a>

  <!-- 1. Hero Section -->
    <header id="top" class="hero-container">
    <div class="hero-content">
      <h1 class="hero-title">
        {homepage?.heroTitle ?? 'Process Apostle'}
      </h1>

      <p class="hero-subtitle">
        {homepage?.heroSubtitle ?? 'Workflow, Purpose & Weekly Insights'}
      </p>

      <a
        href={internalHref(homepage?.heroButtonUrl, '#menu-hub')}
        class="hero-btn"
      >
        {homepage?.heroButtonLabel ?? 'Explore Site'}
      </a>
    </div>
  </header>

  <!-- 2. Navigation Hub Section -->
  <main id="menu-hub" class="section-container hub-container">
    <h2 class="section-title">
      {homepage?.hubTitle ?? 'Explore Site'}
    </h2>

    <div class="hub-grid">
      <a href="#about" class="hub-card">
        {homepage?.aboutNavLabel ?? 'About'}
      </a>

      <a href="#article" class="hub-card">
        {homepage?.articleNavLabel ?? 'Article of the Week'}
      </a>

      <a href="#videos" class="hub-card">
        {homepage?.videosNavLabel ?? 'Video Collections'}
      </a>

      <a href="#contact" class="hub-card">
        {homepage?.contactNavLabel ?? 'Contact Us'}
      </a>
    </div>
  </main>

  <!-- 3. About Section -->
  <section id="about" class="section-container">
    <h2 class="section-title">
      {homepage?.aboutTitle ?? 'About'}
    </h2>

    <div class="content-card">
      <p class="about-lead">
        {homepage?.aboutLead ??
          'Welcome to Process Apostle, a platform dedicated to refining workflows, exploring purpose, and sharing weekly insights.'}
      </p>

      <div class="about-grid">
        <div class="about-box">
          <h3>
            {homepage?.missionHeading ?? 'Mission & Vision'}
          </h3>

          <p>
            {homepage?.missionDescription ??
              'Documenting practical processes, goal tracking, and strategic milestones to empower personal and technical growth.'}
          </p>
        </div>

        <div class="about-box">
          <h3>
            {homepage?.focusHeading ?? 'Weekly Focus'}
          </h3>

          <p>
            {homepage?.focusDescription ??
              'Every week, we break down actionable ideas, curated articles, and media projects designed to build long-term momentum.'}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Article of the Week / Keystatic Posts -->
  <section id="article" class="section-container">
    <h2 class="section-title">
      {homepage?.articleHeading ?? 'Article of the Week'}
    </h2>

   <div class="content-card featured-article-card">
      {featuredPost && FeaturedContent ? (
        <div>
          <div class="article-meta">Featured Article</div>

          <h3 class="article-title">
            {featuredPost.data.title}
          </h3>

          <div class="article-body">
            <FeaturedContent />
          </div>

          <a
            class="hero-btn"
            href={`${base}posts/${featuredPost.id}`}
          >
            Read Article
          </a>
        </div>
      ) : (
        <div>
          <div class="article-meta">Coming Soon</div>

          <h3 class="article-title">Articles and Insights</h3>

          <p class="article-body">
            Our featured articles and reflections will appear here.
            Visit again as the collection grows.
          </p>
        </div>
      )}

      <div class="archive-section">
        <h4>Past Published Articles</h4>

        {archivePosts.length > 0 ? (
          <ul class="archive-list">
            {archivePosts.map((post) => (
              <li class="archive-item">
                <a href={`${base}posts/${post.id}`}>
                  <span>{post.data.title}</span>
                  <span>Read Article →</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p>No archived articles yet.</p>
        )}
      </div>
    </div>
  </section>

 
 
  <!-- 5. Video Collections Section -->
  <section id="videos" class="section-container">
    <h2 class="section-title">
      {homepage?.videosNavLabel ?? 'Video Collections'}
    </h2>

    <div class="content-card">
      {videos.length > 0 ? (
    <div class="video-featured">
  {firstVideo && (firstMp4Url || firstEmbedUrl) ? (
    <>
      <div class="video-featured-player" id="featured-video-player">
        {firstMp4Url ? (
          <video
            id="featured-video"
            controls
            playsinline
            preload="metadata"
            poster={firstThumbnail ?? undefined}
          >
            <source src={firstMp4Url} type="video/mp4" />
          </video>
        ) : (
          <iframe
            id="featured-video"
            src={firstEmbedUrl!}
            title={firstVideo.data.title}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        )}
      </div>

      <h3 id="featured-video-title">{firstVideo.data.title}</h3>
      <p id="featured-video-description">{firstVideo.data.description}</p>
    </>
  ) : (
    <p>Select a video below to begin watching.</p>
  )}
</div>

<div class="video-selection-grid">
  {videos.map((video, index) => {
    const embedUrl = getYouTubeEmbedUrl(video.data.videoUrl);
    const mp4Url = video.data.videoFile
      ? video.data.videoFile.startsWith('http')
        ? video.data.videoFile
        : `${base}${video.data.videoFile.replace(/^\/+/, '')}`
      : null;

    const thumbnail = video.data.thumbnail
      ? `${base}${video.data.thumbnail.replace(/^\/+/, '')}`
      : '';

    return (
      <button
        type="button"
        class:list={['video-select-button', { active: index === 0 }]}
        data-video-type={mp4Url ? 'mp4' : embedUrl ? 'youtube' : 'none'}
        data-video-url={mp4Url ?? embedUrl ?? ''}
        data-video-title={video.data.title}
        data-video-description={video.data.description ?? ''}
        data-video-thumbnail={thumbnail}
      >
        {thumbnail && (
          <img
            src={thumbnail}
            alt=""
            loading="lazy"
            style="width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 6px; margin-bottom: 10px;"
          />
        )}
        <h3>{video.data.title}</h3>
        <p>{video.data.description}</p>
      </button>
    );
  })}
</div>
      ) : (
        <p>Our video collection is coming soon. Please check back again.</p>
      )}
    </div>
  </section>



  <!-- 6. Contact Us & Referrals Section -->
  <section id="contact" class="section-container">
    <h2 class="section-title">
      {homepage?.contactHeading ?? 'Contact Us'}
    </h2>

    <div class="content-card contact-container">
      <p>
        {homepage?.contactDescription ??
          'Have questions, feedback, or ideas to share? Feel free to connect below.'}
      </p>

      <div class="contact-links">
        <a
          href={`mailto:${homepage?.contactEmail ?? 'your-email@example.com'}`}
          class="contact-btn"
        >
          {homepage?.emailButtonLabel ?? 'Email Us'}
        </a>

        <a
          href={homepage?.githubUrl ?? 'https://github.com/crisregil-marte'}
          target="_blank"
          rel="noopener noreferrer"
          class="contact-btn"
        >
          {homepage?.githubButtonLabel ?? 'GitHub Profile'}
        </a>
      </div>

      <!-- Partner Referrals -->
      {contactProcessImage && (
        <div class="contact-process">
         <h3>{homepage?.contactProcessHeading ?? 'How Consultation Works'}</h3>
          <img
            src={contactProcessImage}
            alt="Consultation process flow"
            loading="lazy"
          />
        </div>
      )}

      <!-- Partner Referrals -->
      <div class="referrals-box">
        <h4>
          {homepage?.referralsHeading ?? 'Referrals & Collaborations'}
        </h4>

        <p>
          {homepage?.referralsDescription ??
            'Interested in partnering or recommending our resources? Learn more about our referral program below.'}
        </p>

        <a
          href={internalHref(homepage?.referralsButtonUrl, 'referrals')}
          class="contact-btn"
        >
          {homepage?.referralsButtonLabel ?? 'View Referrals Page'}
        </a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <p>
      {homepage?.footerText ?? '© 2026 Process Apostle. Built with Astro.'}
    </p>
  </footer>
</Layout>
<script>
  const player = document.getElementById('featured-video-player');
  const title = document.getElementById('featured-video-title');
  const description = document.getElementById('featured-video-description');

  const videoButtons = document.querySelectorAll('.video-select-button');

  videoButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const type = button.dataset.videoType;
      const url = button.dataset.videoUrl;
      const videoTitle = button.dataset.videoTitle;
      const videoDescription = button.dataset.videoDescription;
      const thumbnail = button.dataset.videoThumbnail;

      if (!player || !url) return;

      player.replaceChildren();

      if (type === 'mp4') {
        const video = document.createElement('video');
        video.controls = true;
        video.playsInline = true;
        video.preload = 'metadata';

        if (thumbnail) video.poster = thumbnail;

        const source = document.createElement('source');
        source.src = url;
        source.type = 'video/mp4';

        video.appendChild(source);
        player.appendChild(video);
      } else if (type === 'youtube') {
        const iframe = document.createElement('iframe');
        iframe.src = url;
        iframe.title = videoTitle || 'Selected video';
        iframe.allow =
          'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;

        player.appendChild(iframe);
      } else {
        player.textContent = 'Video preview unavailable';
      }

      if (title) title.textContent = videoTitle || '';
      if (description) description.textContent = videoDescription || '';

      videoButtons.forEach((item) => item.classList.remove('active'));
      button.classList.add('active');
    });
  });
</script>